# PureHarvest FastAPI Backend Environment Template
# ==============================================================================
# Database Configuration
# Default to SQLite for zero-config local run, or use PostgreSQL:
# postgresql+psycopg2://postgres:postgres@localhost:5432/pureharvest
DATABASE_URL=sqlite:///./pureharvest.db

# Security & JWT Token Secrets (Replace in production)
SECRET_KEY=pureharvest-super-secure-jwt-secret-key-change-in-production-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Operational & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
