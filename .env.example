# ==============================================================================
# PureHarvest - Environment Configuration Template
# NOTE: Do NOT store sensitive secrets, tokens, or private keys in this file.
# Copy this template to .env.local for local overrides.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging Configuration (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Rate Limiting & Backpressure
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=15000

# API Security (Placeholder for production service configurations)
# NEXT_PUBLIC_API_BASE_URL=https://api.pureharvest.org
